# MusicReleases — bootstrap settings only.
# Everything else (public URL, Spotify/TIDAL apps, mail, schedules) is set in the web installer
# on first start and stored encrypted in the database.
#
#   cp .env.example .env   and fill in the three values marked REQUIRED.

# --- PostgreSQL (runs in its own "db" container) ---
POSTGRES_USER=music
POSTGRES_PASSWORD=          # REQUIRED — letters and digits only, e.g. from: openssl rand -hex 32
POSTGRES_DB=music

# --- Encryption key for stored settings and OAuth tokens ---
# REQUIRED. Generate with:  openssl rand -base64 48
# Back it up together with the database: without it, stored settings and tokens cannot be read.
APP_SECRET=

# --- Cloudflare Tunnel ---
# REQUIRED. Zero Trust → Networks → Tunnels → your tunnel → copy the token from the "run" command.
TUNNEL_TOKEN=

# --- Optional ---
# Fixed setup token for the installer instead of a random one printed in the app log.
INSTALL_TOKEN=
# Timezone used until you pick one in the installer.
TZ=Europe/Amsterdam
# Run one release sync as soon as the worker starts.
RUN_SYNC_ON_START=false

# --- Local development only (npm run dev / npm run dev:worker) ---
# DATABASE_URL=postgresql://music:<password>@127.0.0.1:5432/music
