generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum Provider {
  spotify
  tidal
}

enum ReleaseType {
  album
  single
}

enum DatePrecision {
  day
  month
  year
}

/// Installer / admin settings. Keys: site, spotify, tidal, mail, schedule, install.
model AppSetting {
  key       String   @id
  /// JSON, or an encrypted envelope when `encrypted` is true
  value     String
  encrypted Boolean  @default(false)
  updatedAt DateTime @updatedAt
}

model Artist {
  id           String          @id @default(cuid())
  provider     Provider
  providerId   String
  name         String
  imageUrl     String?
  lastSyncedAt DateTime?
  followers    UserArtist[]
  releases     ReleaseArtist[]

  @@unique([provider, providerId])
}

model UserArtist {
  userId   String
  artistId String
  artist   Artist @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@id([userId, artistId])
}

model Release {
  id            String          @id @default(cuid())
  provider      Provider
  providerId    String
  title         String
  type          ReleaseType
  releaseDate   DateTime        @db.Date
  datePrecision DatePrecision
  coverUrl      String?
  url           String
  totalTracks   Int?
  firstSeenAt   DateTime        @default(now())
  artists       ReleaseArtist[]

  @@unique([provider, providerId])
  @@index([releaseDate])
}

model ReleaseArtist {
  releaseId String
  artistId  String
  release   Release @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  artist    Artist  @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@id([releaseId, artistId])
}

model UserSettings {
  userId           String    @id
  digestEmail      String?
  digestEnabled    Boolean   @default(true)
  unsubscribeToken String    @unique @default(cuid())
  lastDigestSentAt DateTime?
}

model SyncRun {
  id          String    @id @default(cuid())
  startedAt   DateTime  @default(now())
  finishedAt  DateTime?
  userId      String?
  newReleases Int       @default(0)
  error       String?
}

// ---- Better Auth core tables (better-auth 1.7) ----

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  /// 'admin' | 'user'
  role          String    @default("user")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  /// The provider's user id
  accountId             String
  /// 'spotify' | 'tidal'
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  needsReconnect        Boolean   @default(false)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}
