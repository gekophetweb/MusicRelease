# Bootstrap settings only. Everything else (public URL, Spotify/Tidal apps, mail, schedules)
# is configured in the web installer on first start and stored encrypted in the database.

# PostgreSQL (runs in its own "db" container)
POSTGRES_USER=music
POSTGRES_PASSWORD=change-me
POSTGRES_DB=music

# Local development only (npm run dev). Inside Docker this is set by docker-compose.yml.
DATABASE_URL=postgresql://music:change-me@127.0.0.1:5432/music
